# Copie para .env e preencha. O .env nunca vai para o git nem para o navegador.

# Porta do sistema (tabela de orientacoes-projetos-ia.md)
PORT=3011

# Login do SQL Server (o mesmo para todas as unidades)
DB_USUARIO=
DB_SENHA=

# Login próprio do servidor da Flores
FLORES_DB_USUARIO=
FLORES_DB_SENHA=

# Por quanto tempo reaproveitar a última consulta de cada unidade (minutos)
CACHE_MINUTOS=15

# Pasta das planilhas (classificação, vendas do CD e recibos da Flores). Vazio = dados/ deste projeto.
# Para usar sempre as mesmas planilhas do painel por loja, aponte para a pasta dados/ dele.
PASTA_DADOS=
